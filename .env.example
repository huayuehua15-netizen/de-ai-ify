# —— 运行 ——
DEAIIFY_ENV=dev
DEAIIFY_HOST=127.0.0.1
DEAIIFY_PORT=8000

# —— 标准栈（Docker；见 docs/DEVELOPMENT.md §2.3 D，开发默认）——
DEAIIFY_DATABASE_URL=postgresql+asyncpg://deaiify:deaiify@127.0.0.1:5433/deaiify
DEAIIFY_REDIS_URL=redis://127.0.0.1:6380/0

# —— lite 备选（无 Docker，SQLite + 进程内队列）——
# DEAIIFY_DATABASE_URL=sqlite+aiosqlite:///./data/deaiify.db
# DEAIIFY_REDIS_URL=                 # 空 = 进程内队列

# —— 鉴权与限流（API key 留空 = 不鉴权，适合本地/内网）——
DEAIIFY_API_KEY=
DEAIIFY_RATE_LIMIT_PER_MIN=60

# —— 隐私（never = 默认不保存原文）——
DEAIIFY_STORE=never                 # never | optin

# —— 模型（评分功能不需要模型；改写默认用维护者提供的 OpenAI 兼容端点）——
# 开发默认：把维护者提供的地址填到 BASE_URL、密钥填到 API_KEY
DEAIIFY_OPENAI_API_KEY=
DEAIIFY_OPENAI_BASE_URL=            # OpenAI 兼容端点（vLLM / DeepSeek / 网关等皆可）
DEAIIFY_ANTHROPIC_API_KEY=          # 可选 provider
DEAIIFY_OLLAMA_BASE_URL=http://127.0.0.1:11434   # 可选 provider（非开发必需）
DEAIIFY_DEFAULT_PROVIDER=openai
DEAIIFY_DEFAULT_MODEL=

# —— 引擎 ——
DEAIIFY_MAX_TEXT_CHARS=20000
DEAIIFY_BATCH_CONCURRENCY=3
DEAIIFY_REWRITE_TIMEOUT_S=120
